# Server Environment Variables

# Database
DATABASE_URL="mysql://food_search:food_password@localhost:3306/food_search"

# Stripe (Test Mode)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PRICE_ID="price_your_stripe_price_id"
